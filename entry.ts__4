// Discord Interactions webhook endpoint. Receives slash commands from Discord,
// verifies the Ed25519 signature, executes the action, and responds with a
// Discord Container V2 message.
export default async function (req) {
  try {
    const raw = await req.text();
    const signature = req.headers.get("X-Signature-Ed25519");
    const timestamp = req.headers.get("X-Signature-Timestamp");
    const publicKey = secrets.get("DISCORD_PUBLIC_KEY");

    if (!signature || !timestamp || !publicKey) {
      return Response.json({ error: "Missing signature headers" }, { status: 401 });
    }
