const db = globalThis.__B44_DB__ || { auth:{ isAuthenticated: async()=>false, me: async()=>null }, entities:new Proxy({}, { get:()=>({ filter:async()=>[], get:async()=>null, create:async()=>({}), update:async()=>({}), delete:async()=>({}) }) }), integrations:{ Core:{ UploadFile:async()=>({ file_url:'' }) } } };

import { createClientFromRequest } from "npm:@base44/sdk@0.8.44";
import { GUILD_IDS } from "../../shared/constants.js";
import { isGuildAdmin } from "../../shared/discordAdmin.js";
import { registerGuildCommands } from "../../shared/discordApi.js";

// Registers the bot's slash commands with Discord for a guild.
// Admin-gated via the caller's Discord OAuth2 access token.
export default async function (req) {
  try {
    const base44 = createClientFromRequest(req);
    const body = await req.json().catch(() => ({}));
    const accessToken = body.accessToken;
    const guildId = body.guildId || GUILD_IDS[0];

    if (!accessToken) return Response.json({ error: "Unauthorized" }, { status: 401 });
    const admin = await isGuildAdmin(accessToken, guildId);
    if (!admin) return Response.json({ error: "You are not an administrator of this guild" }, { status: 403 });

    const commands = await registerGuildCommands(guildId);
    await db.asServiceRole.entities.AuditLog.create({
      guild_id: guildId,
      event: "config_change",
      actor_id: body.actorId || "",
      actor_name: body.actorName || "",
      details: "Registered slash commands",
      severity: "info"
    });
    return Response.json({ ok: true, count: commands.length, commands });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}